# Copy this file to .env and fill in real values. Never commit .env.

# ── Database (Postgres / Neon) ──────────────────────────────────────────────
# DATABASE_URL is used at runtime (pooled connection recommended, e.g. Neon's
# transaction pooler). DIRECT_URL is used by Prisma Migrate/db push, which
# needs a direct (non-pooled) session connection.
DATABASE_URL=
DIRECT_URL=

# ── Supabase Auth ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, used for admin user management. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app, used to build links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated list of emails to notify on new leads.
LEAD_NOTIFICATION_EMAILS=

# ── Meta (Facebook) Lead Ads webhook ────────────────────────────────────────
# See meta_setup.md for how to obtain these.
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Used by /api/webhook/meta/debug for manual testing.
DEFAULT_USER_ID=

# ── Meta Conversions API (lead-quality signal back to Meta) ────────────────
META_DATASET_ID=
# Falls back to META_PAGE_ACCESS_TOKEN if not set.
META_CAPI_ACCESS_TOKEN=

# ── Meta Ads Insights (spend / cost-per-lead on the Analytics page) ────────
# Ad account ID, with or without the "act_" prefix.
META_AD_ACCOUNT_ID=
# Needs ads_read on the ad account. Falls back to META_PAGE_ACCESS_TOKEN if not set.
META_ADS_ACCESS_TOKEN=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional fallback template name used when no WhatsAppTemplateRule matches.
WHATSAPP_AUTO_TEMPLATE=

# ── Cron endpoints (meeting/follow-up reminders) ────────────────────────────
CRON_SECRET=

# ── AI assistant (DeepSeek) ──────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Test flags (optional, only needed to run integration tests) ────────────
# RUN_LLM_TESTS=1
# RUN_DB_TESTS=1
