    {
      "parameters": {
        "jsCode": "// Code Node: Normalize Indian Phone Number Format (91XXXXXXXXXX)\n\nconst items = $input.all();\n\nfor (const item of items) {\n\n  let phone = item.json.phone_number; // ✅ Use item, not $item\n\n  if (!phone) {\n    item.json.phone_validation_error = \"Phone number missing\";\n    continue;\n  }\n\n  // 1️⃣ Remove all non-numeric characters (+, spaces, etc.)\n  phone = String(phone).replace(/\\D/g, \"\");\n\n  // 2️⃣ If number is exactly 10 digits → add 91\n  if (phone.length === 10) {\n    phone = \"91\" + phone;\n  }\n\n  // 3️⃣ If starts with 91 and total length is 12 → keep it\n  else if (phone.startsWith(\"91\") && phone.length === 12) {\n    // valid, do nothing\n  }\n\n  // 4️⃣ If longer than 12 digits and starts with 91 → fix it\n  else if (phone.startsWith(\"91\") && phone.length > 12) {\n    phone = \"91\" + phone.slice(-10);\n  }\n\n  // 5️⃣ Otherwise → invalid\n  else {\n    item.json.phone_validation_error = \"Invalid phone number format\";\n    continue;\n  }\n\n  // ✅ Final assignment\n  item.json.phone_number = phone;\n}\n\nreturn items;\n"
      },
