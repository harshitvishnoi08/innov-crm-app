    {
      "parameters": {
        "jsCode": "// Code Node: Normalize Indian Phone Number Format (91XXXXXXXXXX)\n\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  \n  let phone = item.json.customer_phone_number;\n\n  if (!phone) {\n    results.push(item);\n    continue;\n  }\n\n  // 1️⃣ Remove all non-numeric characters (+, spaces, etc.)\n  phone = phone.replace(/\\D/g, \"\");\n\n  // 2️⃣ If number starts with 91 and length is 12 → keep it\n  if (phone.startsWith(\"91\") && phone.length === 12) {\n    item.json.customer_phone_number = phone;\n  }\n\n  // 3️⃣ If number is 10 digits → add 91 prefix\n  else if (phone.length === 10) {\n    item.json.customer_phone_number = \"91\" + phone;\n  }\n\n  // 4️⃣ If number starts with 91 but length is more than 12 → fix it\n  else if (phone.startsWith(\"91\") && phone.length > 12) {\n    // Keep last 10 digits and add 91\n    const last10 = phone.slice(-10);\n    item.json.customer_phone_number = \"91\" + last10;\n  }\n\n  // 5️⃣ If invalid → mark as invalid\n  else {\n    item.json.phone_validation_error = \"Invalid phone number format\";\n  }\n\n  results.push(item);\n}\n\nreturn results;\n"
      },
